APP_NAME=Agentic Interviewer
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
AUTH_REQUIRED=false
AUTH_TOKEN_SECRET=
SQLITE_PATH=.data/interviewer.db
DATABASE_URL=postgresql://interviewer:interviewer@127.0.0.1:5433/interviewer
MAX_RESUME_BYTES=5242880
PROVIDER_PROFILE=local-specialized
REASONING_PROVIDER_NAME=vllm
REASONING_BASE_URL=http://127.0.0.1:8080
REASONING_API_KEY=
REASONING_MODEL=mistral-7b-instruct-v0.3-q4
# Explicit privacy declaration for this local deployment, not a generic provider default.
REASONING_REGION=local
REASONING_EXTERNAL_PROCESSING=false
REASONING_RETAINS_PROVIDER_DATA=false
REASONING_CHECK_HEALTH_ENDPOINT=true
# The persistent 16 GiB combined profile leaves GPU headroom for Whisper and Kokoro.
# Override to 0.90 only for the isolated Q4 reasoning benchmark.
VLLM_Q4_GPU_MEMORY_UTILIZATION=0.50
VLLM_Q8_GPU_MEMORY_UTILIZATION=0.90
# Per-request decoding controls for concise, schema-bounded interview output.
REASONING_MAX_COMPLETION_TOKENS=1024
REASONING_TEMPERATURE=0.3
REASONING_TOP_P=0.9
REASONING_PRESENCE_PENALTY=0.0
SPEACHES_BASE_URL=http://127.0.0.1:8001
SPEACHES_API_KEY=
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-small.en
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_DEFAULT_VOICE=af_heart
SPEACHES_REGION=local
SPEACHES_EXTERNAL_PROCESSING=false
SPEACHES_RETAINS_PROVIDER_DATA=false
SPEACHES_CHECK_HEALTH_ENDPOINT=true
# Candidate browser and application-owned realtime connection.
CANDIDATE_UI_ENABLED=true
REALTIME_MAX_MESSAGE_BYTES=1048576
REALTIME_CONNECT_TIMEOUT_SECONDS=10
REALTIME_VAD_THRESHOLD=0.9
REALTIME_SILENCE_DURATION_MS=1500
# Used when PROVIDER_PROFILE=openai-compatible. Model names must match that endpoint.
AUDIO_PROVIDER_NAME=openai-compatible
AUDIO_BASE_URL=https://api.openai.com
AUDIO_API_KEY=
AUDIO_STT_MODEL=whisper-1
AUDIO_TTS_MODEL=tts-1
AUDIO_DEFAULT_VOICE=alloy
AUDIO_REGION=vendor
AUDIO_EXTERNAL_PROCESSING=true
AUDIO_RETAINS_PROVIDER_DATA=true
AUDIO_CHECK_HEALTH_ENDPOINT=false
# Hosted processing/retention is denied unless these deployment policy controls are explicit.
ALLOW_EXTERNAL_MODEL_PROCESSING=false
ALLOW_PROVIDER_DATA_RETENTION=false
ALLOWED_PROVIDER_REGIONS=[]
MAX_QUESTIONS=20
MAX_REDIRECTS_PER_QUESTION=2
MAX_INPUT_TOKENS=32000
MAX_OUTPUT_TOKENS=6000
MAX_AUDIO_SECONDS=300
MAX_SYNTHESIZED_CHARACTERS=12000
MAX_ESTIMATED_COST_USD=1.00
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2
# Provisional per-model-call overload protection, not an interview concurrency SLO.
# compose.load-test.yaml raises these only while measuring the full ladder.
MAX_CONCURRENT_MODEL_CALLS=4
MAX_CONCURRENT_MODEL_CALLS_PER_TENANT=4
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RECOVERY_SECONDS=30
